# انسخ هذا الملف إلى .env محليًا ولا ترفع .env إلى Git.
# لا تضع القيم الحقيقية داخل المستودع.

# Spring Boot
PORT=8080
APP_VERSION=dev

# Supabase API/Auth
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_JWT_SECRET=<YOUR_SUPABASE_JWT_SECRET>

# Supabase PostgreSQL Connection Pooler
# استخدم Transaction Pooler غالبًا على المنفذ 6543 مع sslmode=require.
SPRING_DATASOURCE_URL=jdbc:postgresql://<POOLER_HOST>:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=<YOUR_DATABASE_PASSWORD>

# Pool settings
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_LIFETIME_MS=1800000
DB_VALIDATION_TIMEOUT_MS=5000
DB_INIT_FAIL_TIMEOUT_MS=-1

# Frontend/CORS لاحقًا
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,https://*.e2b.app

# WebRTC لاحقًا
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
